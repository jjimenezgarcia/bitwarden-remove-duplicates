#!/bin/bash

# ANSI color codes
RED='\033[38;5;203m'
WHITE='\033[0;37m'
NC='\033[0m' # No Color

VERBOSE=0
while getopts "v" opt; do
    case "$opt" in
        v) VERBOSE=1 ;;
        *) echo "Usage: $0 [-v]"; exit 1 ;;
    esac
done

# Ensure the user is logged in
echo "Checking Bitwarden session..."
SESSION_CHECK=$(bw status | jq -r '.status')

if [ "$SESSION_CHECK" != "unlocked" ]; then
    echo "You are not logged in or your vault is locked."
    echo "Please unlock your vault (bw unlock) or login (bw login) first."
    echo "Then export your BW_SESSION as provided by the unlock command (ex: $ export BW_SESSION='<session_key>')"
    exit 1
fi

# Get duplicated items with their info
ITEMS=$(bw list items | \
jq '
    map(select(.type == 1))
    | group_by([.name, .login.username, .login.password])
    | map(
        select(length > 1)
        | sort_by(.revisionDate // "")
        | .[:-1]
      )
    | add // []
')

# Check if there are duplicates
DUP_COUNT=$(echo "$ITEMS" | jq 'length')
if [ "$DUP_COUNT" -eq 0 ]; then
    echo -e "${RED}No duplicate items found.${NC}"
    exit 0
fi

echo "Found $DUP_COUNT duplicate item(s) (keeping newest by revision date, deleting the rest)."

if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${RED}To delete:${NC}"
    echo "$ITEMS" | jq -r '.[] | "\(.name) | \(.login.username)"' | while read -r line; do
        echo -e "${WHITE}$line${NC}"
    done
fi

# Ask for confirmation
echo -e "${RED}Type 'continue' to proceed with deletion:${NC}"
read -r CONFIRM

if [ "$CONFIRM" != "continue" ]; then
    echo "Aborted."
    exit 0
fi

# Delete items
echo "$ITEMS" | jq -r '.[] | .id' | while read -r id; do
    echo "[i] Deleting item with ID: $id"
    bw delete item "$id"
done

